# Copy this file to .env.local (never commit .env.local) and fill in your Supabase project's values.
# Both are public by design: the browser needs them, and row-level security protects the data.
# Find them in the Supabase dashboard: Project Settings > API Keys (use the "publishable" key, never the secret one).
# Leave them empty to use the old admin.json password sign-in. See dev/SETUP.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
